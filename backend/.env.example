# Server Port
PORT=5000

# Supabase Credentials (Get from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Settings (Nodemailer / SMTP Config)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Winstar Digital Printing" <noreply@winstardigital.com>

# Business WhatsApp Config
WHATSAPP_BUSINESS_NUMBER=9345046665

# Frontend App URL
FRONTEND_URL=http://localhost:3000
