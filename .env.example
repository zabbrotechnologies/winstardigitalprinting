# ============================================================
# Appwrite Configuration (Backend Server & Client)
# Get these from your Appwrite Console (Cloud or Self-Hosted)
# ============================================================
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=xerox-digital-pro
APPWRITE_API_KEY=your_appwrite_server_secret_api_key_here
APPWRITE_DATABASE_ID=xerox_digital_pro
APPWRITE_USERS_COLLECTION_ID=users_profile
APPWRITE_ORDERS_COLLECTION_ID=orders
APPWRITE_STORAGE_BUCKET_ID=print_files

# ============================================================
# Server Configuration
# ============================================================
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================================
# Vite Client (prefix with VITE_ to expose to browser)
# On Vercel: VITE_API_URL can be left blank (relative /api requests)
# ============================================================
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=xerox-digital-pro
VITE_APPWRITE_DATABASE_ID=xerox_digital_pro
VITE_APPWRITE_USERS_COLLECTION_ID=users_profile
VITE_APPWRITE_ORDERS_COLLECTION_ID=orders
VITE_APPWRITE_STORAGE_BUCKET_ID=print_files
VITE_API_URL=
